@model Opportunity
@{
    ViewData["Title"] = "Delete Opportunity";
}
<div class="row justify-content-center"><div class="col-md-7">
    <div class="card border-danger"><div class="card-body">
        <h1 class="h4 text-danger"><i class="bi bi-exclamation-triangle"></i> Delete opportunity?</h1>
        <p>You are about to delete <strong>@Model.OpportunityName</strong> (@Ui.Money(Model.Amount)). This action is recorded in the audit log.</p>
        <form asp-action="Delete" asp-route-id="@Model.OpportunityId" method="post" class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div></div>
</div></div>
