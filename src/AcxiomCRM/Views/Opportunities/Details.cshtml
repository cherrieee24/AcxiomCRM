@model DetailsViewModel<Opportunity>
@{
    var o = Model.Item;
    ViewData["Title"] = o.OpportunityName;
    var canDelete = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
    var stages = Enum.GetValues<OpportunityStage>().Where(s => s != OpportunityStage.Lost).ToList();
}
<div class="page-header">
    <div>
        <h1>@o.OpportunityName <span class="@Ui.Badge(o.Stage) fs-6 align-middle">@o.Stage</span></h1>
        <small class="text-muted">for <a asp-controller="Customers" asp-action="Details" asp-route-id="@o.CustomerId">@o.Customer?.CustomerName</a></small>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="FollowUps" asp-action="Create" asp-route-opportunityId="@o.OpportunityId" asp-route-customerId="@o.CustomerId" class="btn btn-outline-primary"><i class="bi bi-calendar-plus"></i> Schedule Follow-Up</a>
        <a asp-action="Edit" asp-route-id="@o.OpportunityId" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        @if (canDelete) { <a asp-action="Delete" asp-route-id="@o.OpportunityId" class="btn btn-outline-danger"><i class="bi bi-trash"></i></a> }
    </div>
</div>

<div class="card mb-3"><div class="card-body">
    <div class="d-flex justify-content-between flex-wrap gap-2">
        @foreach (var s in stages)
        {
            var reached = o.Stage == OpportunityStage.Lost ? false : (int)s <= (int)o.Stage;
            <div class="flex-fill text-center">
                <div class="progress" style="height:6px"><div class="progress-bar @(reached ? (o.Stage == OpportunityStage.Won ? "bg-success" : "") : "bg-light")" style="width:100%"></div></div>
                <small class="@(o.Stage == s ? "fw-bold" : "text-muted")">@s</small>
            </div>
        }
    </div>
    @if (o.Stage == OpportunityStage.Lost) { <div class="text-danger small mt-2"><i class="bi bi-x-octagon"></i> This opportunity was lost.</div> }
</div></div>

<div class="row g-3">
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Amount</div><div class="fs-4 fw-bold">@Ui.Money(o.Amount)</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Probability</div><div class="fs-4 fw-bold">@o.Probability%</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Weighted Amount</div><div class="fs-4 fw-bold">@Ui.Money(o.WeightedAmount)</div></div></div></div>
    <div class="col-md-3"><div class="card h-100"><div class="card-body"><div class="small text-muted">Expected Close</div><div class="fs-4 fw-bold">@Ui.Date(o.ExpectedCloseDate)</div></div></div></div>
</div>

<div class="row g-3 mt-1">
    <div class="col-lg-5">
        <div class="card h-100"><div class="card-body">
            <dl class="detail-list mb-0">
                <dt>Status</dt><dd><span class="@Ui.Badge(o.Status)">@o.Status</span> @(o.ClosedDate.HasValue ? "on " + Ui.Timestamp(o.ClosedDate.Value) : "")</dd>
                <dt>Source Lead</dt><dd>@if (o.Lead != null) { <a asp-controller="Leads" asp-action="Details" asp-route-id="@o.LeadId">@o.Lead.LeadName</a> } else { <text>—</text> }</dd>
                <dt>Owner</dt><dd>@(o.AssignedUser?.FullName ?? "Unassigned")</dd>
                <dt>Created</dt><dd>@Ui.Timestamp(o.CreatedDate)</dd>
                <dt>Notes</dt><dd class="text-pre">@(o.Notes ?? "—")</dd>
            </dl>
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header">Follow-Ups</div>
            <ul class="list-group list-group-flush">
                @foreach (var f in o.FollowUps.Where(f => !f.IsDeleted).OrderByDescending(f => f.FollowUpDate))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span><a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId">@f.Subject</a> <small class="text-muted">· @Ui.Date(f.FollowUpDate)</small></span>
                        <span class="@Ui.Badge(f.Status)">@f.Status</span>
                    </li>
                }
                @if (!o.FollowUps.Any(f => !f.IsDeleted)) { <li class="list-group-item text-muted">No follow-ups.</li> }
            </ul>
        </div>
    </div>
</div>
<partial name="_AuditHistory" model="Model.History" />
