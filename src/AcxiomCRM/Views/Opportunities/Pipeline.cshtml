@model IReadOnlyList<Opportunity>
@{
    ViewData["Title"] = "Sales Pipeline";
}
<div class="page-header">
    <h1><i class="bi bi-kanban"></i> Sales Pipeline</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> New Opportunity</a>
</div>
<div class="d-flex gap-3 overflow-auto pb-3">
    @foreach (var stage in Enum.GetValues<OpportunityStage>())
    {
        var items = Model.Where(o => o.Stage == stage).ToList();
        <div class="pipeline-col flex-fill">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="@Ui.Badge(stage) fs-6">@stage</span>
                <small class="text-muted">@items.Count · @Ui.Money(items.Sum(i => i.Amount))</small>
            </div>
            @foreach (var o in items)
            {
                <div class="card pipeline-card mb-2">
                    <div class="card-body p-2">
                        <a asp-action="Details" asp-route-id="@o.OpportunityId" class="fw-semibold small d-block">@o.OpportunityName</a>
                        <div class="small text-muted">@o.Customer?.CustomerName</div>
                        <div class="d-flex justify-content-between small mt-1">
                            <span>@Ui.Money(o.Amount)</span><span>@o.Probability%</span>
                        </div>
                        <div class="small text-muted">Close: @Ui.Date(o.ExpectedCloseDate)</div>
                    </div>
                </div>
            }
            @if (items.Count == 0) { <div class="text-muted small border rounded p-3 text-center bg-white">No opportunities</div> }
        </div>
    }
</div>
@if (Model.Count >= 100) { <p class="small text-muted">Showing the first 100 opportunities by close date. Use the list view to filter.</p> }
