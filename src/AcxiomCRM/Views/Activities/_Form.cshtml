@model ActivityInput
@{
    var customers = ViewData["Customers"] as List<SelectListItem> ?? new();
    var leads = ViewData["Leads"] as List<SelectListItem> ?? new();
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
<div class="row g-3">
    <div class="col-md-3">
        <label asp-for="ActivityType" class="form-label required"></label>
        <select asp-for="ActivityType" class="form-select" asp-items="EnumExtensions.ToSelectList(Model.ActivityType)"></select>
        <span asp-validation-for="ActivityType"></span>
    </div>
    <div class="col-md-9">
        <label asp-for="Subject" class="form-label required"></label>
        <input asp-for="Subject" class="form-control" maxlength="150" />
        <span asp-validation-for="Subject"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="ActivityDate" class="form-label required"></label>
        <input asp-for="ActivityDate" class="form-control" />
        <span asp-validation-for="ActivityDate"></span>
    </div>
    <div class="col-md-4">
        <label asp-for="Status" class="form-label required"></label>
        <select asp-for="Status" class="form-select" asp-items="EnumExtensions.ToSelectList(Model.Status)"></select>
        <span asp-validation-for="Status"></span>
    </div>
    <div class="col-md-4"></div>
    <div class="col-md-6">
        <label asp-for="CustomerId" class="form-label"></label>
        <select asp-for="CustomerId" class="form-select" asp-items="customers"><option value="">-- None --</option></select>
        <span asp-validation-for="CustomerId"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="LeadId" class="form-label"></label>
        <select asp-for="LeadId" class="form-select" asp-items="leads"><option value="">-- None --</option></select>
        <span asp-validation-for="LeadId"></span>
    </div>
    <partial name="_AssignedTo" model="Model.AssignedTo" />
    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
        <span asp-validation-for="Description"></span>
    </div>
</div>
