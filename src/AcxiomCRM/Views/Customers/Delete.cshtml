@model Customer
@{
    ViewData["Title"] = "Delete Customer";
}
<div class="row justify-content-center"><div class="col-md-7">
    <div class="card border-danger">
        <div class="card-body">
            <h1 class="h4 text-danger"><i class="bi bi-exclamation-triangle"></i> Delete customer?</h1>
            <p>You are about to delete <strong>@Model.CustomerName</strong> (@Model.CustomerCode). The record will be hidden from all lists
               but kept in the audit trail. Customers with open opportunities cannot be deleted.</p>
            <form asp-action="Delete" asp-route-id="@Model.CustomerId" method="post" class="d-flex gap-2">
                <button type="submit" class="btn btn-danger">Yes, delete</button>
                <a asp-action="Details" asp-route-id="@Model.CustomerId" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div></div>
