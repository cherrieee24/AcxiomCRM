@model DetailsViewModel<Customer>
@{
    var c = Model.Item;
    ViewData["Title"] = c.CustomerName;
    var canDelete = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager);
}
<div class="page-header">
    <div>
        <h1>@c.CustomerName <span class="@Ui.Badge(c.Status) fs-6 align-middle">@c.Status.DisplayName()</span></h1>
        <small class="text-muted">@c.CustomerCode @(c.CompanyName != null ? "· " + c.CompanyName : "")</small>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Opportunities" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-outline-primary"><i class="bi bi-briefcase"></i> New Opportunity</a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-outline-primary"><i class="bi bi-calendar-plus"></i> Schedule Follow-Up</a>
        <a asp-controller="Activities" asp-action="Create" asp-route-customerId="@c.CustomerId" class="btn btn-outline-primary"><i class="bi bi-journal-plus"></i> Log Activity</a>
        <a asp-action="Edit" asp-route-id="@c.CustomerId" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        @if (canDelete)
        {
            <a asp-action="Delete" asp-route-id="@c.CustomerId" class="btn btn-outline-danger"><i class="bi bi-trash"></i></a>
        }
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-4">
        <div class="card h-100"><div class="card-body">
            <dl class="detail-list mb-0">
                <dt>Email</dt><dd><a href="mailto:@c.Email">@c.Email</a></dd>
                <dt>Phone</dt><dd>@c.Phone</dd>
                <dt>Address</dt><dd>@string.Join(", ", new[] { c.Address, c.City, c.State }.Where(x => !string.IsNullOrEmpty(x))) @(c.Address == null && c.City == null ? "—" : "")</dd>
                <dt>Assigned To</dt><dd>@(c.AssignedUser?.FullName ?? "Unassigned")</dd>
                <dt>Created</dt><dd>@Ui.Timestamp(c.CreatedDate)</dd>
                @if (c.ModifiedDate.HasValue) { <dt>Last Modified</dt><dd>@Ui.Timestamp(c.ModifiedDate.Value)</dd> }
                <dt>Notes</dt><dd class="text-pre">@(c.Notes ?? "—")</dd>
            </dl>
        </div></div>
    </div>
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">Opportunities</div>
            <div class="table-responsive">
                <table class="table table-sm mb-0">
                    <thead><tr><th>Name</th><th>Stage</th><th class="text-end">Amount</th><th>Close Date</th></tr></thead>
                    <tbody>
                        @foreach (var o in c.Opportunities.Where(o => !o.IsDeleted).OrderByDescending(o => o.CreatedDate))
                        {
                            <tr>
                                <td><a asp-controller="Opportunities" asp-action="Details" asp-route-id="@o.OpportunityId">@o.OpportunityName</a></td>
                                <td><span class="@Ui.Badge(o.Stage)">@o.Stage</span></td>
                                <td class="text-end">@Ui.Money(o.Amount)</td>
                                <td>@Ui.Date(o.ExpectedCloseDate)</td>
                            </tr>
                        }
                        @if (!c.Opportunities.Any(o => !o.IsDeleted)) { <tr><td colspan="4" class="text-muted">No opportunities yet.</td></tr> }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header">Follow-Ups</div>
            <ul class="list-group list-group-flush">
                @foreach (var f in c.FollowUps.Where(f => !f.IsDeleted).OrderByDescending(f => f.FollowUpDate))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span><a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId">@f.Subject</a>
                            <small class="text-muted">· @Ui.Date(f.FollowUpDate)</small></span>
                        <span class="@Ui.Badge(f.Status)">@(f.IsOverdue ? "Overdue" : f.Status.ToString())</span>
                    </li>
                }
                @if (!c.FollowUps.Any(f => !f.IsDeleted)) { <li class="list-group-item text-muted">No follow-ups.</li> }
            </ul>
        </div>
        <div class="card">
            <div class="card-header">Activities</div>
            <ul class="list-group list-group-flush">
                @foreach (var a in c.Activities.Where(a => !a.IsDeleted).OrderByDescending(a => a.ActivityDate))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span><span class="badge bg-light text-dark border">@a.ActivityType</span>
                            <a asp-controller="Activities" asp-action="Details" asp-route-id="@a.ActivityId">@a.Subject</a></span>
                        <small class="text-muted">@Ui.Date(a.ActivityDate)</small>
                    </li>
                }
                @if (!c.Activities.Any(a => !a.IsDeleted)) { <li class="list-group-item text-muted">No activities logged.</li> }
            </ul>
        </div>
    </div>
</div>
<partial name="_AuditHistory" model="Model.History" />
