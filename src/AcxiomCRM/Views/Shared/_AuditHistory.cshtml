@model List<HistoryEntry>
<div class="card mt-4">
    <div class="card-header"><i class="bi bi-clock-history"></i> Change History</div>
    @if (Model.Count == 0)
    {
        <div class="card-body text-muted">No history recorded.</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var entry in Model)
            {
                var log = entry.Log;
                var badge = log.Action switch
                {
                    AuditActions.Create => "bg-success",
                    AuditActions.Delete => "bg-danger",
                    AuditActions.Update => "bg-primary",
                    _ => "bg-secondary"
                };
                var verb = log.Action switch
                {
                    AuditActions.Create => "Created",
                    AuditActions.Update => "Updated",
                    AuditActions.Delete => "Deleted",
                    AuditActions.Convert => "Converted",
                    _ => log.Action
                };
                <li class="list-group-item">
                    <div class="d-flex justify-content-between flex-wrap gap-2">
                        <span><span class="badge @badge">@verb</span> by <strong>@(log.UserName ?? "System")</strong></span>
                        <small class="text-muted">@Ui.Timestamp(log.CreatedDate)</small>
                    </div>
                    @if (log.Action != AuditActions.Create && entry.Changes.Count > 0)
                    {
                        <table class="table table-sm table-borderless history-table mb-0 mt-2">
                            <tbody>
                                @foreach (var c in entry.Changes)
                                {
                                    <tr>
                                        <th scope="row">@c.Field</th>
                                        @if (log.Action == AuditActions.Update)
                                        {
                                            <td><span class="history-old">@(c.From ?? "—")</span></td>
                                            <td class="history-arrow"><i class="bi bi-arrow-right"></i></td>
                                            <td><span class="history-new">@(c.To ?? "—")</span></td>
                                        }
                                        else
                                        {
                                            <td colspan="3">@(c.To ?? c.From)</td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </li>
            }
        </ul>
    }
</div>
