@model LeadInput
@{
    var statuses = (ViewData["Statuses"] as List<LeadStatus>) ?? LeadService.InitialStatuses.ToList();
    var statusItems = statuses.Select(s => new SelectListItem(s.DisplayName(), s.ToString(), s == Model.Status));
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="LeadName" class="form-label required"></label>
        <input asp-for="LeadName" class="form-control" maxlength="100" />
        <span asp-validation-for="LeadName"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="CompanyName" class="form-label"></label>
        <input asp-for="CompanyName" class="form-control" maxlength="150" />
        <span asp-validation-for="CompanyName"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" maxlength="150" />
        <span asp-validation-for="Email"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" maxlength="10" inputmode="numeric" placeholder="10-digit mobile" />
        <span asp-validation-for="Phone"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Source" class="form-label required"></label>
        <select asp-for="Source" class="form-select" asp-items="EnumExtensions.ToSelectList(Model.Source)"><option value="">-- Select --</option></select>
        <span asp-validation-for="Source"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Status" class="form-label required"></label>
        <select asp-for="Status" class="form-select" asp-items="statusItems"></select>
        <span asp-validation-for="Status"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="Priority" class="form-label required"></label>
        <select asp-for="Priority" class="form-select" asp-items="EnumExtensions.ToSelectList(Model.Priority)"></select>
        <span asp-validation-for="Priority"></span>
    </div>
    <div class="col-md-3">
        <label asp-for="ExpectedValue" class="form-label required"></label>
        <div class="input-group">
            <span class="input-group-text">₹</span>
            <input asp-for="ExpectedValue" class="form-control" type="number" min="0" step="0.01" />
        </div>
        <span asp-validation-for="ExpectedValue"></span>
    </div>
    <partial name="_AssignedTo" model="Model.AssignedTo" />
    <div class="col-12">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control" rows="3" maxlength="1000"></textarea>
        <span asp-validation-for="Notes"></span>
    </div>
</div>
