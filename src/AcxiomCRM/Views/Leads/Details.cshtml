@model DetailsViewModel<Lead>
@{
    var l = Model.Item;
    ViewData["Title"] = l.LeadName;
    var canDelete = (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Manager)) && l.Status != LeadStatus.Converted;
}
<div class="page-header">
    <div>
        <h1>@l.LeadName <span class="@Ui.Badge(l.Status) fs-6 align-middle">@l.Status</span></h1>
        <small class="text-muted">@l.LeadCode @(l.CompanyName != null ? "· " + l.CompanyName : "")</small>
    </div>
    <div class="d-flex flex-wrap gap-2">
        @if (l.Status == LeadStatus.Qualified)
        {
            <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-success"><i class="bi bi-arrow-right-circle"></i> Convert Lead</a>
        }
        @if (l.Status != LeadStatus.Converted)
        {
            <a asp-controller="FollowUps" asp-action="Create" asp-route-leadId="@l.LeadId" class="btn btn-outline-primary"><i class="bi bi-calendar-plus"></i> Schedule Follow-Up</a>
            <a asp-controller="Activities" asp-action="Create" asp-route-leadId="@l.LeadId" class="btn btn-outline-primary"><i class="bi bi-journal-plus"></i> Log Activity</a>
            <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-primary"><i class="bi bi-pencil"></i> Edit</a>
        }
        @if (canDelete)
        {
            <a asp-action="Delete" asp-route-id="@l.LeadId" class="btn btn-outline-danger"><i class="bi bi-trash"></i></a>
        }
    </div>
</div>

@if (l.Status == LeadStatus.Converted)
{
    <div class="alert alert-success">
        <i class="bi bi-check2-circle"></i> Converted on @Ui.Timestamp(l.ConvertedDate!.Value)
        @if (l.ConvertedCustomer != null)
        {
            <text>to customer <a asp-controller="Customers" asp-action="Details" asp-route-id="@l.ConvertedCustomerId">@l.ConvertedCustomer.CustomerName</a>.</text>
        }
    </div>
}

<div class="row g-3">
    <div class="col-lg-5">
        <div class="card h-100"><div class="card-body">
            <dl class="detail-list mb-0">
                <dt>Email</dt><dd>@(l.Email ?? "—")</dd>
                <dt>Phone</dt><dd>@(l.Phone ?? "—")</dd>
                <dt>Source</dt><dd>@l.Source.DisplayName()</dd>
                <dt>Priority</dt><dd><span class="@Ui.Badge(l.Priority)">@l.Priority</span></dd>
                <dt>Expected Value</dt><dd>@Ui.Money(l.ExpectedValue)</dd>
                <dt>Assigned To</dt><dd>@(l.AssignedUser?.FullName ?? "Unassigned")</dd>
                <dt>Created</dt><dd>@Ui.Timestamp(l.CreatedDate)</dd>
                <dt>Notes</dt><dd class="text-pre">@(l.Notes ?? "—")</dd>
            </dl>
        </div></div>
    </div>
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header">Status Workflow</div>
            <div class="card-body">
                @{ var next = LeadService.Transitions[l.Status]; }
                @if (next.Length == 0)
                {
                    <span class="text-muted">This lead has reached a final status.</span>
                }
                else
                {
                    <span class="text-muted">Next allowed statuses:</span>
                    @foreach (var s in next) { <span class="@Ui.Badge(s) ms-1">@s</span> }
                    @if (l.Status == LeadStatus.Qualified) { <span class="@Ui.Badge(LeadStatus.Converted) ms-1">Converted (via Convert)</span> }
                }
            </div>
        </div>
        <div class="card mb-3">
            <div class="card-header">Follow-Ups</div>
            <ul class="list-group list-group-flush">
                @foreach (var f in l.FollowUps.Where(f => !f.IsDeleted).OrderByDescending(f => f.FollowUpDate))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span><a asp-controller="FollowUps" asp-action="Details" asp-route-id="@f.FollowUpId">@f.Subject</a> <small class="text-muted">· @Ui.Date(f.FollowUpDate)</small></span>
                        <span class="@Ui.Badge(f.Status)">@f.Status</span>
                    </li>
                }
                @if (!l.FollowUps.Any(f => !f.IsDeleted)) { <li class="list-group-item text-muted">No follow-ups.</li> }
            </ul>
        </div>
        <div class="card">
            <div class="card-header">Activities</div>
            <ul class="list-group list-group-flush">
                @foreach (var a in l.Activities.Where(a => !a.IsDeleted).OrderByDescending(a => a.ActivityDate))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span><span class="badge bg-light text-dark border">@a.ActivityType</span> @a.Subject</span>
                        <small class="text-muted">@Ui.Date(a.ActivityDate)</small>
                    </li>
                }
                @if (!l.Activities.Any(a => !a.IsDeleted)) { <li class="list-group-item text-muted">No activities logged.</li> }
            </ul>
        </div>
    </div>
</div>
<partial name="_AuditHistory" model="Model.History" />
