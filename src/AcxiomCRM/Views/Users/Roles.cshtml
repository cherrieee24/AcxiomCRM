@model List<RoleSummaryViewModel>
@{
    ViewData["Title"] = "Roles";
}
<div class="page-header">
    <h1><i class="bi bi-person-badge"></i> Roles</h1>
    <a asp-action="Permissions" class="btn btn-outline-primary"><i class="bi bi-ui-checks-grid"></i> View Permissions</a>
</div>
<p class="text-muted">Each user has exactly one role. Change a user's role from <a asp-action="Index">Users</a> &rarr; Edit; role changes are audited and take effect within a minute.</p>
<div class="row g-3">
    @foreach (var r in Model)
    {
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@Roles.DisplayName(r.Role)</span>
                    <span class="badge bg-primary">@r.Members.Count user@(r.Members.Count == 1 ? "" : "s")</span>
                </div>
                <div class="card-body">
                    <p class="text-muted small">@r.Description</p>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var m in r.Members)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <div class="fw-semibold">@m.FullName @if (!m.IsActive) { <span class="badge bg-secondary">Inactive</span> }</div>
                                <small class="text-muted">@m.Email</small>
                            </div>
                            <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary" title="Edit user / change role"><i class="bi bi-pencil"></i></a>
                        </li>
                    }
                    @if (r.Members.Count == 0) { <li class="list-group-item text-muted">No users in this role.</li> }
                </ul>
            </div>
        </div>
    }
</div>
