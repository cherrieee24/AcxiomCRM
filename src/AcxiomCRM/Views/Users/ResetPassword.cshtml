@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset Password";
}
<div class="row justify-content-center"><div class="col-md-6">
    <h1 class="h4 mb-3">Reset password for @Model.FullName</h1>
    <div class="card"><div class="card-body">
        <form asp-action="ResetPassword" method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>
            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label required"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </div>
            <div class="mb-3">
                <label asp-for="ConfirmPassword" class="form-label required"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword"></span>
            </div>
            <p class="small text-muted">The user's existing sessions will be signed out and any lockout cleared. This action is audited.</p>
            <button type="submit" class="btn btn-primary">Reset Password</button>
            <a asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div></div>
</div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
