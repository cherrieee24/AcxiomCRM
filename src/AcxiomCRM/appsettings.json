{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=App_Data/acxiomcrm.db;Cache=Shared"
  },
  "Security": {
    "PasswordMinLength": 8,
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15,
    "AuthRequestsPerMinute": 10
  },
  "ReverseProxy": {
    "Enabled": false
  },
  "Seed": {
    "SampleData": false,
    "Users": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
