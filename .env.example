# Copy to .env (never commit .env) and fill in.

# First admin account - created on first start only. Must satisfy the password policy:
# 8+ chars with upper case, lower case, a digit and a symbol.
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Port on the host machine
HOST_PORT=8080

# Production keeps HTTPS-only cookies. Set to false ONLY to try the container over plain
# http://localhost - never on a public server.
Security__RequireHttps=true

# Set to true when running behind nginx / a cloud load balancer that terminates HTTPS.
ReverseProxy__Enabled=false

# Load demo customers/leads/opportunities (true for a demo environment only).
Seed__SampleData=false
